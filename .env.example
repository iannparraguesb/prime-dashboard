# Variables del dashboard. Copia este archivo a `.env` y rellena los valores.
# `.env` esta ignorado por git: nunca lo subas.
#
# Son dos pares con el mismo valor a proposito. Las `VITE_` se hornean en el
# bundle durante el build y viajan al navegador; las otras solo las lee la
# funcion del servidor. La anon key es publica por diseno -- lo que protege los
# datos es el RLS con lista blanca, no que la clave sea secreta.

# --- Navegador (build time) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=pon-aqui-la-anon-key
# Opcional: boton "Soporte" de la barra superior. Un WhatsApp o un formulario
# (https:// o mailto:). Sin esta variable el boton no aparece.
VITE_SOPORTE_URL=https://wa.me/56900000000?text=Hola%2C%20tengo%20una%20consulta%20sobre%20el%20panel

# --- Servidor (la funcion de Vercel) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=pon-aqui-la-anon-key

# --- Alumnos: registro con codigo y conexion de Instagram (solo servidor) ---
# Ver docs/instagram-alumnos.md. Nunca con prefijo VITE_. IG_APP_ID es el
# "Identificador de la app de Instagram", no el de la app de Facebook.
IG_APP_ID=pon-aqui-el-id-de-la-app-de-instagram
IG_APP_SECRET=pon-aqui-la-clave-de-la-app-de-instagram
IG_REDIRECT_URI=https://app.primeclubacademy.io/conectar/instagram
SUPABASE_SERVICE_KEY=pon-aqui-la-clave-de-servicio
# Opcional: sincronizar apenas un alumno conecta, sin esperar el cron.
# Token fine-grained de GitHub solo para este repo, permiso "Actions: Read and write".
GH_REPO=iannparraguesb/prime-dashboard
GH_WORKFLOW_TOKEN=pon-aqui-el-token

# --- Contador compartido del rate limit ---
# OBLIGATORIO en produccion. Sin estas dos, `rateLimit` lanza 503 en toda
# peticion cuando corre en Vercel: falla cerrado a proposito, para no quedar
# sin limites. En local, si faltan, se usa un contador en memoria.
UPSTASH_REDIS_REST_URL=https://TU-BASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=pon-aqui-el-token

# --- Opcional: aviso de vencimiento del token de Instagram ---
# Solo alimenta el indicador de la seccion de salud. Formato YYYY-MM-DD.
IG_TOKEN_EXPIRA=2026-10-29

# --- Solo para la suite de pruebas de integracion ---
# Usuario con rol `lectura`: la suite nunca debe poder escribir.
# No cargues estas dos en Vercel.
TEST_EMAIL=usuario-de-pruebas@ejemplo.com
TEST_PASSWORD=pon-aqui-la-clave

# --- Solo desarrollo local ---
# Puerto del API cuando corres `npm run dev`. Por defecto 5175.
PUERTO_API=5175

# NUNCA pongas aqui, ni en Vercel, una SERVICE_ROLE_KEY con prefijo VITE_.
# Hay una prueba (`pruebas/seguridad.test.mjs`) que falla si un secreto
# privado aparece en el codigo fuente o en el build.
